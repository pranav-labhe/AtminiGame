<?xml version="1.0" encoding="utf-8"?>
<gameMusic>

    <!-- 1. Landing / Idle: Futuristic Sentinel - alert but at rest, standing guard -->
    <track id="landing" tempo="62" root="D" scale="phrygian">
        <bass waveform="square" octave="2" volume="0.22" />
        <pad waveform="sawtooth" attack="2.0" release="4.0" volume="0.25" wobble="0.2" />
        <arpeggio pattern="1,4,5,8,10,8,5,4,1,8,10,13,10,8,5,4" noteLength="eighth" volume="0.35" />
    </track>

    <!-- 2. Game Screen: Futuristic Sentinel - locked-in, mechanical, mission-focused -->
    <track id="game" tempo="76" root="D" scale="phrygian">
        <bass waveform="square" octave="1" volume="0.4" />
        <pad waveform="sawtooth"
            attack="1.5"
            release="3.0"
            volume="0.25"
            wobble="0.35" />
        <arpeggio
            pattern="1,4,5,8,5,1,8,11,8,5,1,10,13,10,5,8,11,15,11,8"
            noteLength="sixteenth"
            volume="0.55" />
    </track>

    <!-- 2b. AI Auto Mode: High-octane Cybernetic Scanning -->
    <track id="aimode" tempo="88" root="D" scale="dorian">
        <bass waveform="square" octave="1" volume="0.45" />
        <pad waveform="sawtooth"
            attack="1.0"
            release="2.0"
            volume="0.28"
            wobble="0.5" />
        <arpeggio
            pattern="1,3,5,7,8,10,12,10,8,7,5,3,1,5,8,12,15,12,8,5"
            noteLength="sixteenth"
            volume="0.6" />
    </track>

    <!-- 3. Success: Futuristic Sentinel - mission accomplished, disciplined not celebratory -->
    <track id="success" tempo="82" root="D" scale="mixolydian">
        <bass waveform="square" octave="2" volume="0.4" />
        <pad waveform="sawtooth" attack="0.3" release="1.5" volume="0.28" />
        <arpeggio pattern="1,4,5,8,11" noteLength="sixteenth" volume="0.25" />
    </track>

    <!-- 4. Failure: Futuristic Sentinel - system down, breach, not sadness but alarm -->
    <track id="failure" tempo="64" root="D" scale="locrian">
        <bass waveform="square" octave="0" volume="0.6" />
        <pad waveform="sawtooth" attack="3.0" release="5.0" volume="0.12" />
        <arpeggio pattern="1,2,1,5,1" noteLength="quarter" volume="0.08" />
    </track>

</gameMusic>
